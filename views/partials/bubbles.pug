//- A speak/stop button: both Heroicons live here; CSS (.icon.playing) shows one.
//- This is the single source for the icon markup — the client never rebuilds it.
mixin speak-btn
  button.icon(type="button" data-speak aria-label="Play")
    svg.hi.hi-speaker(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true")
      path(stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 0 1 0 12.728M16.463 8.288a5.25 5.25 0 0 1 0 7.424M6.75 8.25l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.009 9.009 0 0 1 2.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75Z")
    svg.hi.hi-pause(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true")
      path(stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25v13.5m-7.5-13.5v13.5")

//- One chat bubble, tutor or learner, driven by a message object {role, nl, en, note}.
mixin bubble(m)
  if m.role === 'learner'
    .bubble.learner(data-nl=m.nl)
      .bubble-head
        span.who You
        +speak-btn
      p.nl= m.nl
      +correction(m.correction)
  else
    .bubble.tutor(data-nl=m.nl)
      .bubble-head
        span.who Saar
        +speak-btn
      //- Show each sentence on its own line for easier reading (data-nl keeps the
      //- full text so text-to-speech still reads it as one piece).
      - var sentences = (String(m.nl).match(/[^.!?]+[.!?]*/g) || [m.nl]).map(function (s) { return s.trim(); }).filter(Boolean)
      p.nl
        each s, i in sentences
          if i
            br
          = s
      if m.glossary && m.glossary.length
        .gloss
          each g in m.glossary
            span.gloss-item
              span.gloss-nl= g.nl
              span.gloss-en= g.en

//- A correction block: every mistake listed, plus the full corrected sentence.
mixin correction(c)
  if c && ((c.mistakes && c.mistakes.length) || c.fixed)
    .note-tip
      if c.mistakes && c.mistakes.length
        ul.mistakes
          each mk in c.mistakes
            li= mk
      if c.fixed
        .fixed
          span.fixed-label Better:
          span.fixed-text= c.fixed

//- One coach Q&A entry (used live and when reloading saved history).
mixin coachMsg(c)
  .coach-msg
    .coach-q= c.question
    .coach-a= c.answer
    if c.examples && c.examples.length
      .coach-examples
        each ex in c.examples
          .coach-ex(data-nl=ex.nl)
            .ex-text
              span.ex-nl= ex.nl
              span.ex-en= ex.en
            +speak-btn
