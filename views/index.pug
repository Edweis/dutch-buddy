extends layout

block content
  section.hero
    h1 Praatmaatje
    p.sub Have a real Dutch conversation. A friendly Dutch speaker talks and writes simple Dutch, you read along and answer out loud, and the words you use stick, Anki-style.

    - var missing = []
    if !status.llm
      - missing.push('OPEN_ROUTER_API_KEY (the conversation)')
    if !status.voice
      - missing.push('AZURE_SPEECH_KEY (Dutch voice in + out)')
    if missing.length
      .note
        strong Setup needed:
        |  add
        each m, i in missing
          |  #{m}#{i < missing.length - 1 ? ',' : ''}
        |  to <code>.env</code>.

  section.stats
    .stat
      .num= stats.introduced
      .label words seen
    .stat
      .num= stats.known
      .label known
    .stat
      .num= stats.mature
      .label mature

  form.start-form(hx-post="/conversation/start", hx-target="main.container", hx-swap="innerHTML")
    label.setup-label(for="context") What do you want to work on? <span>(optional)</span>
    textarea#context.setup-input(name="context", rows="3", placeholder="e.g. You're a waiter at a café and I'm ordering lunch — focus on food, numbers and ordering. Or: let's practice telling the time, days of the week and dates.")
    button.primary(type="submit") Start talking →

  p.hint Allow the microphone when asked. They speak in Dutch; tap 🎙️ to reply out loud.
