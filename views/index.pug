extends layout

block content
  section.hero
    h1 Praat met Saar
    p.sub Have a real Dutch conversation. Saar speaks and writes simple Dutch, you read along and answer out loud — and the words you use stick, Anki-style.

    - var missing = []
    if !status.llm
      - missing.push('OPEN_ROUTER_API_KEY (the conversation)')
    if !status.voice
      - missing.push('AZURE_SPEECH_KEY (Dutch voice in + out)')
    if missing.length
      .note
        strong Setup needed:
        |  add
        each m, i in missing
          |  #{m}#{i < missing.length - 1 ? ',' : ''}
        |  to <code>.env</code>.

  section.stats
    .stat
      .num= stats.introduced
      .label words seen
    .stat
      .num= stats.known
      .label known
    .stat
      .num= stats.mature
      .label mature

  form(hx-post="/conversation/start", hx-target="main.container", hx-swap="innerHTML")
    button.primary(type="submit") Start talking →

  p.hint Use <strong>Chrome</strong> and allow the microphone. Saar speaks in Dutch; tap 🎙️ to reply out loud.
