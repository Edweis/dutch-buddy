extends layout
include partials/bubbles

block content
  .session-grid
    .chat-col
      #chat.chat(data-cid=cid)
        if error
          .bubble.error
            p Saar couldn't start the conversation:
            p.err= error
        else
          each m in messages
            +bubble(m)

      #composer.composer(class=error ? 'hidden' : '')
        p.transcript(data-transcript)
        .controls
          button.record(type="button", data-record) Tap to speak
          button.ghost.hidden(type="button", data-save) Next line
          button.ghost.hidden(type="button", data-cancel) Cancel

      .session-links
        a.hint(href="/conversations") ← All chats
        a.hint(href="/progress") Your words →

    aside.coach-col
      .coach-header
        span.coach-title Coach
        span.coach-sub always here to help
      .coach-intro Ask in English, anytime — e.g. “How do I talk about my job?” or “Why ‘leren’ and not ‘leer’?”
      .coach-log(data-coach-log)
        each c in (coachMessages || [])
          +coachMsg(c)
      form.coach-form(data-coach-form)
        input(type="text", name="q", placeholder="Ask the coach…", autocomplete="off")
        button.ghost(type="submit") Ask
