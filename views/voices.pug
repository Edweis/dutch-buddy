extends layout

block content
  section
    h1 Voice benchmark
    p.sub Type any Dutch text, then play it with each voice to compare. The 🐢 button plays it slowly (same setting Buddy uses for new words).
    if !available
      .note Add <code>AZURE_SPEECH_KEY</code> to <code>.env</code> to enable playback.

    .bench
      textarea#bench-text(rows="3")= sample

      .voice-list
        each v in voices
          .voice-row(data-voice=v.id)
            .voice-meta
              span.voice-name= v.name
              span.voice-sub #{v.gender} · #{v.locale}
              span.voice-id= v.id
              if v.id === defaultVoice
                span.badge.known current
            .voice-actions
              button.ghost(type="button", data-play=v.id) ▶︎ Play
              button.icon(type="button", data-play=v.id, data-slow="1") 🐢

    p.hint To make one the default, set <code>AZURE_SPEECH_VOICE=&lt;id&gt;</code> in <code>.env</code> and restart.

  script.
    (function () {
      let audio = null;
      function play(voice, slow) {
        const text = document.getElementById('bench-text').value.trim();
        if (!text) return;
        if (audio) { audio.pause(); audio = null; }
        const url = '/tts?text=' + encodeURIComponent(text)
          + '&voice=' + encodeURIComponent(voice)
          + '&rate=' + (slow ? 'slow' : 'default');
        audio = new Audio(url);
        audio.play().catch(function (e) { alert('Playback failed: ' + e.message); });
      }
      document.querySelectorAll('[data-play]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          play(btn.getAttribute('data-play'), btn.hasAttribute('data-slow'));
        });
      });
    })();
