doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Dutch Buddy
    script(src="https://unpkg.com/htmx.org@2.0.4")
    script(src="https://cdn.jsdelivr.net/npm/microsoft-cognitiveservices-speech-sdk@1.41.0/distrib/browser/microsoft.cognitiveservices.speech.sdk.bundle-min.js")
    link(rel="stylesheet", href="/css/style.css")
  body
    header.topbar
      a.brand(href="/") 🧡 Dutch Buddy
      nav
        a(href="/") Home
        a(href="/conversations") Chats
        a(href="/progress") Progress
    main.container(class=(typeof bodyClass !== 'undefined' && bodyClass) ? bodyClass : '')
      block content
    script(src="/js/app.js")
