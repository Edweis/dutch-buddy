extends layout

block content
  section
    .conv-head
      h1 Your chats
      form(hx-post="/conversation/start", hx-target="main.container", hx-swap="innerHTML")
        button.primary(type="submit") + New chat

    if convos.length === 0
      p.hint No conversations yet. Start a new chat to begin talking with Saar.
    else
      .conv-list
        each c in convos
          a.conv-row(href=`/conversation/${c.id}`)
            .conv-main
              span.conv-preview= c.preview || 'New conversation'
              span.conv-meta #{c.turns} messages
            span.conv-when= c.when
