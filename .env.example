# Copy this file to .env and fill in your keys.

# --- LLM brain (the conversation) -----------------------------------------
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=anthropic/claude-haiku-4.5

# --- Azure Speech: the Dutch voice (TTS) AND recognizing you (STT) ---------
# One key does both. Region must match where you created the Speech resource.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=northeurope
# Netherlands voice. Flemish option: nl-BE-ArnaudNeural.
AZURE_SPEECH_VOICE=nl-NL-ColetteNeural

PORT=3000
